# Optional Supabase configuration for the next development phase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put a service-role key in a NEXT_PUBLIC variable or commit secrets.

# Server-only credentials for secure Paystack checkout and webhook verification.
# Never prefix either of these with NEXT_PUBLIC_ and never commit real values.
PAYSTACK_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional canonical app origin. If unset, the request origin is used for callbacks.
NEXT_PUBLIC_APP_URL=
